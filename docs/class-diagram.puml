@startuml ExtractorService
title ExtractorService v4 (09.01.26)

class ExtractController {
    - bucketService: BucketService

    + ExtractController(bucketService: BucketService)
    + upload(string:local, string:remote): void
    + download(string:local, string:remote): void
    + update(string:local, string:remote): void
    + delete(string:remote, bool:recursive): void
    + list(string:remote): string[]
    + share(string:remote, int:expirationTime): string
}

class BucketService {
    - factory: ExtractorServiceFactory
    - adapter: ExtractorService

    + BucketService(factory: ExtractorServiceFactory)
    + upload(string:local, string:remote): void
    + download(string:local, string:remote): void
    + update(string:local, string:remote): void
    + delete(string:remote, bool:recursive): void
    + list(string:remote): string[]
    + share(string:remote, int:expirationTime): string
}

class ExtractorServiceFactory {
    - adapters: collection<ExtractorService>

    + getAdapter(): ExtractorService
}

interface ExtractorService {
    + upload(string:local, string:remote): void
    + download(string:local, string:remote): void
    + update(string:local, string:remote): void
    + delete(string:remote, bool:recursive): void
    + list(string:remote): string[]
    + doestExists(string:remote): bool
    + share(string:remote, int:expirationTime): string
}

class AzureAdapterImpl

class GcpAdapterImpl {
    - storage: Storage

    + GcpAdapterImpl()
    - GcpAdapterImpl(storage: Storage)
    - createStorageClient(): Storage
}

class AwsAdapterImpl {
    - s3Client: S3Client
    - s3Presigner: S3Presigner

    + AwsAdapterImpl()
    - AwsAdapterImpl(s3Client: S3Client, s3Presigner: S3Presigner)
    - createS3Client(): S3Client
    - createS3Presigner(): S3Presigner
}

package Helper {
    class AdapterHelper {}
    class ConfigHelper {}
}

' ---- SDK ----
package AWSSDK {
    interface S3Client
    interface S3Presigner
    interface AwsClient
}

package GCPSDK {
    interface Storage
    interface Blob
}

package AZURESDK {}

' ---- Exception ----
package BucketException {
    class BucketOperationException {
        + BucketOperationException(message: String, cause: Exception)
    }

    class BucketObjectNotFoundException {
        + BucketObjectNotFoundException(key: String)
    }

    class InvalidBucketPathException {
        + InvalidBucketPathException(message: String)
    }
}

package Exception {
    class Exception
}

